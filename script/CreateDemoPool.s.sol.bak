pragma solidity ^0.8.10;

import "forge-std/Script.sol";
import {ProratedFactory} from "../src/ProratedFactory.sol";
import {ProratedPool} from "../src/ProratedPool.sol";

contract CreateDemoPool is Script {
    function run() external {
        vm.startBroadcast();

        console.log("Creating demo pool...");
        console.log("Deployer:", msg.sender);

        // Use existing deployed factory
        address factoryAddress = 0x9A676e781A523b5d0C0e43731313A708CB607508;
        address mockUSDC = 0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0;
        
        ProratedFactory factory = ProratedFactory(factoryAddress);
        
        uint256 currentTime = block.timestamp;
        
        // Create a simple active pool
        ProratedPool.PoolConfig memory config = ProratedPool.PoolConfig({
            owner: msg.sender,
            tokenName: "Demo Active Token",
            tokenSymbol: "DACTIVE",
            tokenTotalSupply: 1000000 * 10**18, // 1M tokens
            developmentFund: 25000 * 10**6, // 25K USDC
            liquidityFund: 25000 * 10**6, // 25K USDC
            startTime: currentTime - 1 hours, // Started 1 hour ago
            endTime: currentTime + 7 days, // Ends in 7 days
            fundingToken: mockUSDC,
            developerPercent: 20,
            treasuryPercent: 30,
            daoPercent: 50
        });
        
        address poolAddress = factory.createPool(config, bytes32("demo-active"));
        
        console.log("Demo pool created at:", poolAddress);
        
        vm.stopBroadcast();
    }
}
