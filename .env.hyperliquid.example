# Hyperliquid Testnet Configuration
# Copy this file to .env.hyperliquid and fill in your private key

# Your Hyperliquid testnet wallet private key (with 0x prefix)
HYPERLIQUID_PRIVATE_KEY=0x...

# Network Configuration (don't change these)
HYPERLIQUID_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
HYPERLIQUID_CHAIN_ID=998
HYPERLIQUID_EXPLORER_URL=https://testnet.purrsec.com/

# Optional: Etherscan API key for contract verification (if supported)
HYPERLIQUID_ETHERSCAN_API_KEY=
